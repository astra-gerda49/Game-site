extends ../layouts/pages-layout
block title 
    - var title = 'Dota 2'
block content
    header 
        .dota-box 
            .container-xl.p-0
                .container
                    .row 
                        .col-xxl-6.col-xl-6.col-lg-6.col-md-12 
                            .hero-section.pt-5 
                                h1.hero-title.text-white.m-0 Dota 2
                                    p.hero-desk.text-white.my-5
                                        | Dota 2 - компьютерная игра по сети. 
                                    p.hero-desk.text-white
                                        | В игре участвуют две команды по 5 человек. 
            .img-mobile
                img(src="./img/pic/dota-big.png", alt="")
    main 
        section.gallery.pt-5
            .container-xl.p-0
                .container
                    h1.gallery-title Галерея 
                    .swiper.mySwiper
                        .swiper-wrapper
                            .swiper-slide
                                img(src="./img/pic/slides/dota-slide-1.png")
                            .swiper-slide
                                img(src="./img/pic/slides/dota-slide-2.png")
                        .swiper-button-next
                        .swiper-button-prev
        section.articles.py-5
            .container-xl.p-0
                .container
                    h1.gallery-title Статьи 
                    .row 
                        .col-md-4
                            .card
                                .card-body
                                    img.card-img-top.mb-4(src="./img/pic/articles/dota-article-1.png", alt="...")
                                    h5.card-title Рецензия на Dota: Dragon's Blood.
                                    p.card-text
                                        | Каким получился мультсериал по Dota 2 от авторов "Легенды о Корее"
                                    a.btn.btn-primary(href="#") Читать
                        .col-md-4
                            .card
                                .card-body

                        .col-md-4
                            .card
                                .card-body